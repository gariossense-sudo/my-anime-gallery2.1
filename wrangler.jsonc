{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "my-anime-gallery2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",

  "keep_vars": true,

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
